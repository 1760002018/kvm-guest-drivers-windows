;/*++
;
;INX_COPYRIGHT_1
;INX_COPYRIGHT_2
;
;Module Name:
;    piofs.inf
;
;Abstract:
;
;Installation Notes:
;    Using Devcon: Type "devcon install piofs.inf PCI\VEN_1960&DEV_105A&SUBSYS_1100_INX_SUBSYS_VENDOR_ID&REV_00" to install
;
;--*/

[Version]
Signature       = "$WINDOWS NT$"
Class           = System
ClassGuid       = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider        = %VENDOR%
CatalogFile     = piofs.cat
PnpLockdown     = 1
DriverVer       = 01/01/2008,0.0.0.1 ; this line will be replaced with stampinf

[DestinationDirs]
DefaultDestDir = 12
PhyzioFs_Wdf_CoInstaller_CopyFiles = 11

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
piofs.sys = 1,,
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll = 1 ; make sure the number matches with SourceDisksNames

; ---------------
; Install Section
; ---------------

[Manufacturer]
%VENDOR% = Standard,NT$ARCH$

[Standard.NT$ARCH$]
%PhyzioFs.DeviceDesc% = PhyzioFs_Device, PCI\VEN_1960&DEV_105A&SUBSYS_1100_INX_SUBSYS_VENDOR_ID&REV_00, PCI\VEN_1960&DEV_105A

[PhyzioFs_Device.NT]
CopyFiles = PhyzioFs_CopyFiles

[PhyzioFs_Device.NT.HW]
AddReg = PhyzioFs_AddReg

[PhyzioFs_CopyFiles]
piofs.sys

[PhyzioFs_AddReg]
HKR,Interrupt Management,,0x00000010
HKR,Interrupt Management\MessageSignaledInterruptProperties,,0x00000010
HKR,Interrupt Management\MessageSignaledInterruptProperties,MSISupported,0x00010001,1
HKR,Interrupt Management\MessageSignaledInterruptProperties,MessageNumberLimit,0x00010001,1

; --------------------
; Service Installation
; --------------------

[PhyzioFs_Device.NT.Services]
AddService = PhyzioFsDrv,0x00000002,PhyzioFs_Service_Install

[PhyzioFs_Service_Install]
DisplayName    = %PhyzioFs.Service%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\piofs.sys
LoadOrderGroup = Extended Base

; -------------------------------------
; WDF & Device CoInstaller Installation
; -------------------------------------

[PhyzioFs_Device.NT.CoInstallers]
AddReg=PhyzioFs_Wdf_CoInstaller_AddReg
CopyFiles=PhyzioFs_Wdf_CoInstaller_CopyFiles

[PhyzioFs_Wdf_CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, \
    "WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll,WdfCoInstaller"

[PhyzioFs_Wdf_CoInstaller_CopyFiles]
WdfCoInstaller$KMDFCOINSTALLERVERSION$.dll

[PhyzioFs_Device.NT.Wdf]
KmdfService = PhyzioFsDrv, PhyzioFs_wdfsect

[PhyzioFs_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
VENDOR              = "INX_COMPANY"
DiskName            = "INX_PREFIX_PHYZIOPhyzIO FS Installation Disk"
PhyzioFs.DeviceDesc = "INX_PREFIX_PHYZIOPhyzIO FS Device"
PhyzioFs.Service    = "INX_PREFIX_PHYZIOPhyzIO FS Driver"
