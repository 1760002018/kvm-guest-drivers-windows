<!--
***********************************************************************************************
Driver.BTPW.props
BTPW inf substitutions and versioning used by all drivers.
***********************************************************************************************
-->

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" TreatAsLocalProperty="Platform">
  <PropertyGroup>
    <!-- Second component of driver version -->
    <_BTPW_RELEASE_VERSION_ Condition="'$(_BTPW_RELEASE_VERSION_)' == ''">6</_BTPW_RELEASE_VERSION_>
    <!-- Third component of driver version -->
    <_BUILD_MAJOR_VERSION_ Condition="'$(_BUILD_MAJOR_VERSION_)' == ''">101</_BUILD_MAJOR_VERSION_>
    <!-- Fourth component of driver version -->
    <_BUILD_MINOR_VERSION_ Condition="'$(_BUILD_MINOR_VERSION_)' == ''">58000</_BUILD_MINOR_VERSION_>
  </PropertyGroup>

  <PropertyGroup>
    <STAMPINF_VERSION>$(_NT_TARGET_MAJ).$(_BTPW_RELEASE_VERSION_).$(_BUILD_MAJOR_VERSION_).$(_BUILD_MINOR_VERSION_)</STAMPINF_VERSION>
    <!-- CopyrightStrings should be defined in each project -->
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'BalloonCopyrightStrings'">2009</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'PVPanicCopyrightStrings'">2015</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'PioInputCopyrightStrings'">2016</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'PioRNGCopyrightStrings'">2014</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'PioCryptCopyrightStrings'">2018</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'PioScsiCopyrightStrings'">2012</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'PioSerialCopyrightStrings'">2010</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'PioStorCopyrightStrings'">2008</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'IvshmemCopyrightStrings'">2017</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'NetPTVCopyrightStrings'">2008</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'FwCfgCopyrightStrings'">2018</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(CopyrightStrings)' == 'PioGpuDodCopyrightStrings'">2019</BTPW_COPYRIGHT_STARTING_YEAR>
    <BTPW_COPYRIGHT_STARTING_YEAR Condition="'$(BTPW_COPYRIGHT_STARTING_YEAR)' == ''">20??</BTPW_COPYRIGHT_STARTING_YEAR>

    <!-- BTPW uses a user-mode service to collect memory statistics -->
    <USE_BALLOON_SERVICE>1</USE_BALLOON_SERVICE>
    <!-- Using coinstaller to register piosock socket provider -->
    <USE_PIOSOCK_COINSTALLER>1</USE_PIOSOCK_COINSTALLER>
  </PropertyGroup>

  <PropertyGroup>
    <BTPW_COPYRIGHT_YEARS Condition="'$(BTPW_COPYRIGHT_STARTING_YEAR)'!='$(COPYRIGHT_CURRENT_YEAR)'">$(BTPW_COPYRIGHT_STARTING_YEAR)-$(COPYRIGHT_CURRENT_YEAR)</BTPW_COPYRIGHT_YEARS>
    <BTPW_COPYRIGHT_YEARS Condition="'$(BTPW_COPYRIGHT_STARTING_YEAR)'=='$(COPYRIGHT_CURRENT_YEAR)'">$(COPYRIGHT_CURRENT_YEAR)</BTPW_COPYRIGHT_YEARS>
  </PropertyGroup>

  <!-- Version specs for C preprocessor, resource compiler, and stampinf -->
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_BUILD_MAJOR_VERSION_=$(_BUILD_MAJOR_VERSION_);_BUILD_MINOR_VERSION_=$(_BUILD_MINOR_VERSION_);_NT_TARGET_MAJ=$(_NT_TARGET_MAJ);_BTPW_RELEASE_VERSION_=$(_BTPW_RELEASE_VERSION_);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions>BTPW_COPYRIGHT_STARTING_YEAR=$(BTPW_COPYRIGHT_STARTING_YEAR);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>_BUILD_MAJOR_VERSION_=$(_BUILD_MAJOR_VERSION_);_BUILD_MINOR_VERSION_=$(_BUILD_MINOR_VERSION_);_NT_TARGET_MAJ=$(_NT_TARGET_MAJ);_BTPW_RELEASE_VERSION_=$(_BTPW_RELEASE_VERSION_);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions>BTPW_COPYRIGHT_YEARS="$(BTPW_COPYRIGHT_YEARS)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Substitution Include="INX_COPYRIGHT_1">
      <ReplaceWith>Copyright (c) $(BTPW_COPYRIGHT_YEARS) Blu Tah Inc.</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_COPYRIGHT_2">
      <ReplaceWith></ReplaceWith>
    </Substitution>
    <Substitution Include="INX_COMPANY">
      <ReplaceWith>Blu Tah, Inc.</ReplaceWith>
    </Substitution>
    <Substitution Include="INX_PREFIX_VENDOR">
      <ReplaceWith>Blu Tah </ReplaceWith>
    </Substitution>
    <Substitution Include="INX_PREFIX_PHYZIO">
      <ReplaceWith></ReplaceWith>
    </Substitution>
    <Substitution Include="INX_PREFIX_CECL">
      <ReplaceWith></ReplaceWith>
    </Substitution>
  </ItemGroup>
</Project>
