[Disks]
d2 = "OEM DISK (SCSI) Win2003/32-bit",\disk1,\i386\Win2003

[Defaults]
SCSI = WNET32

[scsi]
WNET32 = "Blu Tah PhyzIO BLOCK Disk Device Win2003/32-bit"

[Files.scsi.WNET32]
driver = d2, piostor.sys, piostor
inf    = d2, piostor.inf
catalog= d2, piostor.cat

[HardwareIds.scsi.WNET32]
id = "PCI\VEN_1960&DEV_1001&SUBSYS_00021960&REV_00", "piostor"

[Config.WNET32]
value = Parameters\PnpInterface,5,REG_DWORD,1

