;-----------------------------------
;INX_COPYRIGHT_1
;INX_COPYRIGHT_2
;-----------------------------------
;          pioprot.inf
;-----------------------------------
;       PHYZIO network protocol
;-----------------------------------

[version]
Signature   = "$Windows NT$"
Class       = NetTrans
ClassGUID   = {4d36e975-e325-11ce-bfc1-08002be10318}
Provider    = %VENDOR%
DriverVer   = 01/01/2020,1.1
CatalogFile  = pioprot.cat


[Manufacturer]
%VENDOR%=Standard,NTx86,NTamd64

[Standard.NTx86]
%NETPTVP_Desc%=Install,PIOPROT

[Standard.NTamd64]
%NETPTVP_Desc%=Install,PIOPROT

;-------------------------------------------------------------------------
; Installation Section
;-------------------------------------------------------------------------
[Install]
AddReg=Inst_Ndi
Characteristics=0x0
CopyFiles=Copy.Exec

;-------------------------------------------------------------------------
; Ndi installation support
;-------------------------------------------------------------------------
[Inst_Ndi]
HKR, Ndi, ClsID, 0, {F69513F1-8E1A-4F35-82D9-046406970E6D}
HKR, Ndi, ComponentDll, , netptvno.dll
HKR,Ndi,Service,,netptvp
HKR,Ndi,HelpText,,%NETPTVP_HelpText%
HKR,Ndi\Interfaces, UpperRange,, noupper
HKR,Ndi\Interfaces, LowerRange,,"ndis5,ndis5_prot"

;-------------------------------------------------------------------------
; Service installation support
;-------------------------------------------------------------------------
[Install.Services]
AddService=netptvp,0x800,NETPTVP.ServiceInst ;SPSVCSINST_STARTSERVICE

[NETPTVP.ServiceInst]
DisplayName     = %NETPTVP_Desc%
ServiceType     = 16 ;SERVICE_WIN32_OWN_PROCESS
StartType       = 2 ;SERVICE_AUTO_START
ErrorControl    = 1 ;SERVICE_ERROR_NORMAL
ServiceBinary   = %11%\netptvp.exe
Description     = %NETPTVP_Desc%

[Install.Remove.Services]
DelService=netptvp,0x200 ;SPSVCINST_STOPSERVICE

;-------------------------------------------------------------------------
; Declare Destination Directories for file copy/deletion
;-------------------------------------------------------------------------
[SourceDisksNames]
1=%DiskDescription%,"",,

[SourceDisksFiles]
netptvno.dll=1
netptvp.exe=1

[DestinationDirs]
Copy.Exec    = 11    ; %windir%\System32

;-------------------------------------------------------------------------
; Files to Copy/Delete - Referenced by Install and Remove sections above
;-------------------------------------------------------------------------
[Copy.Exec]
netptvno.dll,,,0x00004002     ; COPYFLG_NOSKIP | COPYFLG_IN_USE_RENAME
netptvp.exe,,,0x00004002      ; COPYFLG_NOSKIP | COPYFLG_IN_USE_RENAME

[Strings]
VENDOR = "INX_COMPANY"
DiskDescription = "INX_PREFIX_VENDORPhyzIO NetPTV Protocol Driver Disk"
NETPTVP_Desc = "INX_PREFIX_VENDORPhyzIO NetPTV Protocol Driver"
NETPTVP_HelpText = "A driver to support SRIOV Failover for PhyzIO network devices"
